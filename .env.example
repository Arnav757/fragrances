# Copy to .env.local for local development. Never commit real values.

# --- Core -------------------------------------------------------------------
# Postgres connection string. In production use your Supabase project's connection string.
DATABASE_URL=postgres://postgres@localhost:5432/forma
# development | test | staging | production
APP_ENV=development
# Public URL of the site, used in emails and report links (no trailing slash)
SITE_URL=http://localhost:3000
# Long random string (32+ chars). Encrypts stored report links and signs test payments.
# Generate: openssl rand -base64 48   — changing it later breaks "find my report" for older reports.
APP_SECRET=
# Protects /api/cron/retention (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# --- Photo analysis: Claude API -----------------------------------------------
# Without a key, analyses use quiz answers only and photos are just shown to the stylist.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments: Razorpay ------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local/staging only: simulated gateway when Razorpay keys are absent. Refused when APP_ENV=production.
ENABLE_MOCK_PAYMENTS=true

# --- Email: Resend -----------------------------------------------------------
# Without these, emails are stored in the admin Email log and NOT sent.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Private photo storage: Supabase Storage ---------------------------------
# Create a PRIVATE bucket. Without these, photos go to ./.data/photos (local development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=client-photos

# --- Tests -------------------------------------------------------------------
# Separate database used (and wiped) by `npm test`
TEST_DATABASE_URL=postgres://postgres@localhost:5432/forma_test
