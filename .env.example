# Copy to .env.local for local development. Never commit real values.

# --- Core -------------------------------------------------------------------
# Postgres connection string. In production use your Supabase project's connection string
# (Project Settings → Database). The transaction pooler (port 6543) is supported.
DATABASE_URL=postgres://postgres@localhost:5432/noir
# development | test | staging | production
APP_ENV=development
# Public URL of the site, used in emails, sitemap and canonical links (no trailing slash)
SITE_URL=http://localhost:3000
# Long random string (32+ chars). Signs guest order links. Generate: openssl rand -base64 48
APP_SECRET=
# Protects /api/cron/expire-orders (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# --- Payments: Razorpay ------------------------------------------------------
# Use test keys (rzp_test_...) until you are ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Local/staging only: simulated gateway when Razorpay keys are absent. Refused when APP_ENV=production.
ENABLE_MOCK_PAYMENTS=true

# --- Email: Resend -----------------------------------------------------------
# Without these, emails are stored in the admin Email log and NOT sent.
RESEND_API_KEY=
# e.g. "NOIR & NOTES <orders@yourdomain.in>" — the domain must be verified in Resend
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Image storage: Supabase Storage -----------------------------------------
# Without these, uploads go to public/uploads (local development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Optional: Shiprocket serviceability checks -------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# --- Tests -------------------------------------------------------------------
# Separate database used (and wiped) by `npm test`
TEST_DATABASE_URL=postgres://postgres@localhost:5432/noir_test
